{
  "name": "lingodev-assistant",
  "displayName": "LingoDev Assistant",
  "description": "AI-powered localization helper with Lingo CLI, SDK, MCP, and API integration",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:lingoai.extractStrings",
    "onCommand:lingoai.showAISuggestions",
    "onCommand:lingoai.syncWithTeam",
    "onCommand:lingoai.liveTranslationPreview",
    "onCommand:lingoai.resolveConflicts",
    "onCommand:lingoai.teamActivity",
    "onView:lingodev-sidebar"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lingoai.extractStrings",
        "title": "Extract Strings",
        "category": "Lingo AI"
      },
      {
        "command": "lingoai.showAISuggestions",
        "title": "Show AI i18n Suggestions",
        "category": "Lingo AI"
      },
      {
        "command": "lingoai.syncWithTeam",
        "title": "Sync with Team",
        "category": "Lingo AI"
      },
      {
        "command": "lingoai.liveTranslationPreview",
        "title": "Live Translation Preview",
        "category": "Lingo AI"
      },
      {
        "command": "lingoai.resolveConflicts",
        "title": "Resolve Translation Conflicts",
        "category": "Lingo AI"
      },
      {
        "command": "lingoai.teamActivity",
        "title": "Team Activity",
        "category": "Lingo AI"
      }
    ],
    "menus": {
      "command-palette": [
        {
          "command": "lingoai.extractStrings",
          "when": "true"
        },
        {
          "command": "lingoai.showAISuggestions",
          "when": "true"
        },
        {
          "command": "lingoai.syncWithTeam",
          "when": "true"
        },
        {
          "command": "lingoai.liveTranslationPreview",
          "when": "true"
        },
        {
          "command": "lingoai.resolveConflicts",
          "when": "true"
        },
        {
          "command": "lingoai.teamActivity",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lingodevContainer",
          "title": "LingoDev",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "lingodevContainer": [
        {
          "type": "webview",
          "id": "lingodev-sidebar",
          "name": "🌍 LingoDev Assistant"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lingodev-sidebar",
        "contents": "No translations yet. [Extract a string](command:lingoai.extractStrings) to get started with Lingo!"
      }
    ],
    "configuration": {
      "title": "LingoDev Assistant",
      "properties": {
        "lingodevAssistant.enableInlineTranslations": {
          "type": "boolean",
          "default": true,
          "description": "Show translations inline in code"
        },
        "lingodevAssistant.autoSyncWithTeam": {
          "type": "boolean",
          "default": false,
          "description": "Automatically sync translations with team via Lingo API"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  },
  "dependencies": {
    "lingo.dev": "^0.79.5"
  }
}