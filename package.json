{
  "name": "lingodev-assistant",
  "displayName": "LingoDev Assistant",
  "description": "AI-powered localization helper with Lingo CLI, SDK, MCP, and API integration",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:lingodev-assistant.testActivation",
    "onCommand:lingodev-assistant.showSidebar",
    "onCommand:lingodev-assistant.extractString",
    "onCommand:lingodev-assistant.showPreview",
    "onCommand:lingodev-assistant.showAISuggestions",
    "onCommand:lingodev-assistant.syncTeam"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lingodev-assistant.testActivation",
        "title": "Test LingoDev Activation"
      },
      {
        "command": "lingodev-assistant.showSidebar",
        "title": "Show LingoDev Sidebar"
      },
      {
        "command": "lingodev-assistant.extractString",
        "title": "Extract Selected String"
      },
      {
        "command": "lingodev-assistant.showPreview",
        "title": "Show Live Translation Preview"
      },
      {
        "command": "lingodev-assistant.showAISuggestions",
        "title": "Show AI i18n Suggestions"
      },
      {
        "command": "lingodev-assistant.syncTeam",
        "title": "Sync with Team (Lingo API)"
      },
      {
        "command": "lingodev-assistant.resolveConflicts",
        "title": "Resolve Translation Conflicts"
      },
      {
        "command": "lingodev-assistant.showTeamActivity",
        "title": "Show Team Activity"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "lingodev-sidebar",
          "name": "🌍 LingoDev Assistant"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "lingodev-sidebar",
        "contents": "No translations yet. [Extract a string](command:lingodev-assistant.extractString) to get started with Lingo!"
      }
    ],
    "configuration": {
      "title": "LingoDev Assistant",
      "properties": {
        "lingodevAssistant.enableInlineTranslations": {
          "type": "boolean",
          "default": true,
          "description": "Show translations inline in code"
        },
        "lingodevAssistant.autoSyncWithTeam": {
          "type": "boolean", 
          "default": false,
          "description": "Automatically sync translations with team via Lingo API"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}