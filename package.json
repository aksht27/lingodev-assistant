{
  "name": "lingodev-assistant",
  "displayName": "LingoDev Assistant",
  "description": "AI-powered localization helper for developers",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:lingodev-assistant.testActivation",
    "onCommand:lingodev-assistant.showSidebar",
    "onCommand:lingodev-assistant.extractString"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lingodev-assistant.testActivation",
        "title": "Test LingoDev Activation"
      },
      {
        "command": "lingodev-assistant.showSidebar",
        "title": "Show LingoDev Sidebar"
      },
      {
        "command": "lingodev-assistant.extractString",
        "title": "Extract Selected String"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.106.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
